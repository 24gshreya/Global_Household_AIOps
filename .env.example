# GenAI providers
GEMINI_API_KEY=

# Optional OpenAI-compatible provider
OPENAI_API_KEY=

# Model configuration
LLM_MODEL=gemini-3.6-flash
SLM_MODEL=phi-4-mini
FOUNDRY_LOCAL_BASE_URL=http://127.0.0.1:5273/v1

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Dataset
DATASET_PATH=data/raw/Global_Household_Financial_Dynamics.csv